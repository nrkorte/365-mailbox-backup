# Copy this file to .env and fill in real values. .env should NOT be committed
# to source control and should be locked down to read-only for the owning user
# (see README for chmod/icacls guidance).
#
# Only the static app-registration credentials go here. The target mailbox and
# an optional date range change on every run, so they're passed as command-line
# arguments instead - see README "Run" section.

M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Optional overrides:
# M365_PST_PATH=/data/backups/somebody.pst
# M365_CHUNK_SIZE_GB=15
# M365_GRAPH_MAX_REQUESTS_PER_SECOND=8
