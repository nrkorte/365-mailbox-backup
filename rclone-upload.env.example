# Copy this file to rclone-upload.env and fill in real values.
# Used by upload-mailbox-backup.sh.

# The rclone remote name pointing at your corporate Dropbox
# (see: rclone config file / ~/.config/rclone/rclone.conf).
RCLONE_REMOTE=

# Folder path inside that Dropbox remote where zipped backups get uploaded.
# This file is sourced as a shell script, so quote the value if it has spaces.
DROPBOX_FOLDER="Backups/M365"

# Optional override: where to look for .pst chunks (defaults to /data/backups,
# matching Program.cs's DefaultBackupDirectory()).
# M365_BACKUP_DIR=/data/backups
