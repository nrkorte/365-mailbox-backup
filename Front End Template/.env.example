# Copy to .env and fill in real values.
#
# This server never talks to the queue's filesystem directly - it opens an
# SSH session per request and invokes a queue script as a one-off command,
# same as the Node.js example in the main README.

QUEUE_SSH_HOST=
QUEUE_SSH_PORT=22
QUEUE_SSH_USER=
QUEUE_SSH_KEY_PATH=

# Absolute path to the "queue" directory on the remote host, e.g.
# /opt/Email-Backup/queue
QUEUE_REMOTE_DIR=

# What this HTTP server listens on locally. No auth, no TLS - see README.
PORT=3000
